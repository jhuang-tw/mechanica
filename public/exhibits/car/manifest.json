 "lessons": [
  {
   "id": "engine",
   "title": "活塞怎麼讓曲軸轉",
   "steps": [
    {
     "say": "汽缸內的油氣混合後被火星塞點燃，氣體急遽膨脹，把活塞往下推。",
     "parts": [
      "piston_1",
      "piston_2",
      "piston_3",
      "piston_4",
      "block"
     ],
     "drive": "engine",
     "speed": 0.3,
     "quiz": {
      "q": "混合氣在汽缸裡點燃後，活塞會怎麼動？",
      "options": [
       [
        "被膨脹氣體往下推",
        true,
        "高溫氣體膨脹向下推活塞，這是四行程中唯一產生動力的「做功行程」。"
       ],
       [
        "被往上吸",
        false,
        "燃燒會讓氣體膨脹往下推；活塞往上是靠曲軸與飛輪的慣性帶回來的。"
       ]
      ]
     }
    },
    {
     "say": "連桿上端跟著活塞上下動，下端推著曲軸偏心銷繞圈，把直線推力轉成旋轉。",
     "parts": [
      "piston_1",
      "piston_2",
      "piston_3",
      "piston_4",
      "conrod_1",
      "conrod_2",
      "conrod_3",
      "conrod_4",
      "crankshaft"
     ],
     "drive": "engine",
     "speed": 0.3,
     "quiz": {
      "q": "當第 1、4 缸活塞在最上方時，第 2、3 缸活塞在哪裡？",
      "options": [
       [
        "在最下方",
        true,
        "直列四缸的曲柄銷兩兩錯開 180°，1、4 在上時 2、3 剛好在下，能互相抵消慣性震動。"
       ],
       [
        "也在最上方",
        false,
        "四顆活塞同時上下會產生劇烈震動，因此分成兩組錯開 180°。"
       ],
       [
        "在汽缸正中間",
        false,
        "直列四缸的曲柄銷只有上下兩個方向。"
       ]
      ]
     }
    },
    {
     "say": "曲軸透過正時皮帶帶動兩根凸輪軸，以一半的轉速準時頂開進氣門與排氣門。",
     "parts": [
      "crankshaft",
      "crank_pulley",
      "timing_belt",
      "camshaft_intake",
      "camshaft_exhaust"
     ],
     "drive": "engine",
     "speed": 0.3,
     "quiz": {
      "q": "曲軸轉兩圈時，凸輪軸會轉幾圈？",
      "options": [
       [
        "一圈",
        true,
        "四行程（進氣、壓縮、做功、排氣）曲軸要轉兩圈，期間每個氣門只開一次，所以凸輪軸只轉一圈。"
       ],
       [
        "兩圈",
        false,
        "如果轉兩圈，氣門在壓縮與做功時也會打開，引擎就無法運作。"
       ],
       [
        "四圈",
        false,
        "凸輪軸是減速運轉，比曲軸慢一半。"
       ]
      ]
     }
    },
    {
     "say": "四個汽缸依 1-3-4-2 順序輪流點火，曲軸每轉半圈就有一缸出力，搭配飛輪慣性讓運轉更平順。",
     "parts": [
      "flywheel",
      "crankshaft",
      "piston_1",
      "piston_2",
      "piston_3",
