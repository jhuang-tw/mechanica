 "lessons": [
  {
   "id": "engine",
   "title": "活塞怎麼讓曲軸轉",
   "steps": [
    {
     "say": "汽缸裡的混合氣點燃膨脹，把活塞往下推。",
     "parts": [
      "piston_1",
      "piston_2",
      "piston_3",
      "piston_4",
      "block"
     ],
     "drive": "engine",
     "speed": 0.3,
     "quiz": {
      "q": "混合氣在汽缸裡點燃後，活塞會？",
      "options": [
       [
        "被往下推",
        true,
        "燃燒的氣體膨脹，把活塞往下推，這是四行程裡唯一出力的一步。"
       ],
       [
        "被往上吸",
        false,
        "燃燒是膨脹，不是吸；往上是靠曲軸的慣性推回去。"
       ]
      ]
     }
    },
    {
     "say": "連桿把活塞的上下運動，變成曲軸的旋轉。看連桿下端繞著圈。",
     "parts": [
      "piston_1",
      "piston_2",
      "piston_3",
      "piston_4",
      "conrod_1",
      "conrod_2",
      "conrod_3",
      "conrod_4",
      "crankshaft"
     ],
     "drive": "engine",
     "speed": 0.3,
     "quiz": {
      "q": "第 1、4 缸活塞在最上面時，第 2、3 缸在哪裡？",
      "options": [
       [
        "最下面",
        true,
        "曲柄銷兩兩相差 180°，1、4 在上時 2、3 剛好在下，這樣比較平衡。"
       ],
       [
        "也在最上面",
        false,
        "四缸一起上下會震得很厲害，所以曲柄銷錯開 180°。"
       ],
       [
        "在正中間",
        false,
        "直列四缸的曲柄銷只有兩個方向：上或下。"
       ]
      ]
     }
    },
    {
     "say": "曲軸經正時皮帶帶動兩根凸輪軸，轉速只有一半，按時打開進氣門和排氣門。",
     "parts": [
      "crankshaft",
      "crank_pulley",
      "timing_belt",
      "camshaft_intake",
      "camshaft_exhaust"
     ],
     "drive": "engine",
     "speed": 0.3,
     "quiz": {
      "q": "曲軸轉兩圈，凸輪軸轉幾圈？",
      "options": [
       [
        "一圈",
        true,
        "四行程是進氣、壓縮、做功、排氣，曲軸要轉兩圈；每個氣門在這段時間只開一次。"
       ],
       [
        "兩圈",
        false,
        "那樣每個氣門會開兩次，氣門時機就亂了。"
       ],
       [
        "四圈",
        false,
        "凸輪軸比曲軸慢，不是快。"
       ]
      ]
     }
    },
    {
     "say": "飛輪存住慣性，四個汽缸照 1-3-4-2 輪流做功，曲軸每轉半圈就有一缸出力，轉得很平順。",
     "parts": [
      "flywheel",
      "crankshaft",
      "piston_1",
      "piston_2",
      "piston_3",
      "piston_4"
     ],
     "drive": "engine",
     "speed": 0.3
    }
   ]
  },
  {
   "id": "power",
   "title": "引擎的力氣怎麼到輪子",
   "steps": [
    {
     "say": "引擎轉動曲軸和飛輪，離合器接上後，變速箱的輸入軸跟著轉。",
     "parts": [
      "crankshaft",
      "flywheel",
      "input_shaft"
     ],
     "drive": "power",
     "speed": 0.4
    },
    {
