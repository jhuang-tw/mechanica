# Copy to .env (git-ignored). Keys stay on the server; the browser never sees them.
# Meta Model API (https://dev.meta.ai/docs)
META_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_STT_MODEL=muse-voice-transcribe-1.0
# Paid calls per visitor IP per day (public demo guard)
# DAILY_LIMIT=200
# PORT=8098
# Paid calls for the whole server per day (the real ceiling: visitor IPs can be spoofed)
# CAP_PER_DAY=2000
# Spoken answers: Azure neural voices (free tier F0 = 500k characters/month). Without a key the browser's own voice is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE_ZH=zh-TW-HsiaoChenNeural
# AZURE_TTS_VOICE_EN=en-US-AvaMultilingualNeural
# TTS_CHARS_PER_DAY=15000
